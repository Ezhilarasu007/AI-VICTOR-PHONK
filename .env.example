# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/aivictorphonk
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aivictorphonk
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password

# Authentication
AUTH_SECRET=your-auth-secret-key-here
JWT_SECRET=your-jwt-secret-key-here
SESSION_SECRET=your-session-secret-key-here

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_SECRET=your-admin-secret-key

# Ollama Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Firebase (for Android)
FIREBASE_PROJECT_ID=ai-victor-phonk
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=ai-victor-phonk.firebaseapp.com
FIREBASE_STORAGE_BUCKET=ai-victor-phonk.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# AdMob (for Android)
ADMOB_APP_ID=ca-app-pub-6751037211810646~6370835710
ADMOB_BANNER_ID=ca-app-pub-6751037211810646/7948650423
ADMOB_INTERSTITIAL_ID=ca-app-pub-6751037211810646/1514094858
ADMOB_REWARDED_ID=ca-app-pub-6751037211810646/2029100178
ADMOB_NATIVE_ID=ca-app-pub-6751037211810646/3685048341
ADMOB_OPEN_ID=ca-app-pub-6751037211810646/2496089751

# Subscription Configuration
MONTHLY_PRICE=4.99
YEARLY_PRICE=39.99
FREE_TRIAL_DAYS=7

# Server Configuration
PORT=3000
NODE_ENV=production

# API Keys (for external services)
OPENAI_API_KEY=your-openai-api-key
STABILITY_AI_KEY=your-stability-ai-key

# Storage
STORAGE_BUCKET=ai-victor-phonk-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Analytics
GOOGLE_ANALYTICS_ID=your-analytics-id
MIXPANEL_TOKEN=your-mixpanel-token
